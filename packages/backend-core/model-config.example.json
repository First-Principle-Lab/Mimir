{
  "transport": {
    "url": "https://openrouter.ai/api/v1/chat/completions",
    "timeoutMs": 30000,
    "maxAttempts": 2
  },
  "useCases": {
    "interaction": {
      "model": "~deepseek/deepseek-v4-flash-latest",
      "maxInputTokens": 64000,
      "maxOutputTokens": 2048,
      "temperature": 0.7
    },
    "chat_response": {
      "model": "~deepseek/deepseek-v4-flash-latest",
      "maxInputTokens": 8000,
      "maxOutputTokens": 2048,
      "temperature": 0.7
    },
    "evaluation": {
      "model": "openai/gpt-4o-mini",
      "maxInputTokens": 4000,
      "maxOutputTokens": 512,
      "temperature": 0.1
    },
    "fact_extraction": {
      "model": "openai/gpt-4o-mini",
      "maxInputTokens": 4000,
      "maxOutputTokens": 1024,
      "temperature": 0.1
    },
    "fact_conflict": {
      "model": "openai/gpt-4o-mini",
      "maxInputTokens": 4000,
      "maxOutputTokens": 256,
      "temperature": 0.1
    },
    "fact_relations": {
      "model": "openai/gpt-4o-mini",
      "maxInputTokens": 4000,
      "maxOutputTokens": 1024,
      "temperature": 0.1
    }
  },
  "embeddings": {
    "model": "openai/text-embedding-3-small"
  }
}
