generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  user
  assistant
  system
}

enum MessageStatus {
  pending
  streaming
  complete
  failed
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  timezone     String?
  notificationPreferences Json?
  createdAt    DateTime @default(now())

  conversations     Conversation[]
  connections       IntegrationConnection[]
  mcpServers        McpServer[]
  refreshTokens     RefreshToken[]
  usage             UsageRecord[]
  pushSubscriptions PushSubscription[]
  analyticsEvents   AnalyticsEvent[]
  modelCallLogs     ModelCallLog[]
  agentRuns         AgentRun[]
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  // Watermark for the fact-extraction write path: the newest message createdAt
  // that has already been extracted. NULL = nothing extracted yet. Advanced only
  // on a SUCCESSFUL extractFacts run, so a retry re-runs from the last good
  // point (idempotent-ish against failures). All conversations that predate this
  // column have NULL here, so the FIRST run on them backfills the whole thread —
  // see the Task 13.7 design note on the one-time backlog burst.
  lastExtractedAt DateTime?
  messages       Message[]
  facts          ExtractedFact[]
  sessionEntries SessionEntry[]
  agentRuns      AgentRun[]
  inbox          InboxInput[]
  deliveries     Delivery[]
  routines       Routine[]
  emailDrafts    EmailDraft[]

  @@index([userId])
}

model Message {
  id               String        @id @default(uuid())
  conversationId   String
  conversation     Conversation  @relation(fields: [conversationId], references: [id])
  clientMessageId  String?
  role             MessageRole
  content          String        @db.Text
  status           MessageStatus @default(complete)
  toolCalls        Json?
  attachments      Json?
  parentMessageId  String?
  replyToMessageIds String[] @default([])
  model            String?
  tokenCount       Int?
  promptTokens     Int?
  completionTokens Int?
  durationMs       Int?
  errorDetail      Json?
  createdAt        DateTime      @default(now())
  editedAt         DateTime?

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
}
// Flat, atomically-retrievable durable facts extracted from
// the thread (see fact-extraction.ts).
// `status` is a plain string (not a PG enum) because it keeps gaining states —
// active | superseded | deleted — and each addition would otherwise require an
// ALTER TYPE migration. Enforce the allowed set with a TS union at call sites.
//
// Supersede-scan semantics differ deliberately from delete:
//   - supersede: "this fact CHANGED" — old fact PRESERVED + excluded from reads,
//     full history kept (temporal queries); new fact's supersedesId points here.
//   - delete: "this fact should never have been stored / remove it" — status flip,
//     excluded from EVERY read path, never resurfaces, row kept only for audit.
model ExtractedFact {
  id             String   @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  subject        String
  fact           String   @db.Text
  embedding      Unsupported("vector(1536)")? // raw $executeRaw access only (mirrors Agent.embedding)
  factSearch     Unsupported("tsvector")? // generated to_tsvector('english', subject || ' ' || fact); raw SQL only (see migration)
  status         String   @default("active") // active | superseded | deleted
  // open string sets (no PG enum), typed at call sites
  subjectType    String   @default("other") // person | project | preference | date | credential | other
  factType       String   @default("attribute") // attribute | event | relationship | instruction
  sourceMessageId String?
  supersedesId   String?
// SetNull assumes no hard-purge path exists — supersede chains stay
  // soft-deleted (status flip). Rows are never physically removed, so the FK
  // always resolves to an existing (deleted) row.
  supersedes     ExtractedFact?  @relation("FactSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy   ExtractedFact[] @relation("FactSupersedes")
  outgoingRelations FactRelation[] @relation("FactRelationSource")
  incomingRelations FactRelation[] @relation("FactRelationTarget")
  deletedAt      DateTime?
  deletedReason  String? // incorrect_extraction | user_requested | manual_correction
  createdAt      DateTime @default(now())

  @@index([conversationId, status])
  @@index([conversationId, subject])
}

// Directed fact-to-fact edge (fact graph). `relationType` is a free text tag
// (e.g. "affects", "predecessor_of", "example_of"), not an enum — set only by
// the extraction relation pass, never user-typed. Both FKs indexed for the
// bidirectional expansion in searchActiveFactsWithRelations.
model FactRelation {
  id              String   @id @default(uuid())
  sourceFactId    String
  targetFactId    String
  relationType    String
  sourceMessageId String?
  createdAt       DateTime @default(now())

  sourceFact ExtractedFact @relation("FactRelationSource", fields: [sourceFactId], references: [id])
  targetFact ExtractedFact @relation("FactRelationTarget", fields: [targetFactId], references: [id])

  @@index([sourceFactId])
  @@index([targetFactId])
}

// 13.5 — human-gated retrieval tuning proposal. tuneRetrievalParams aggregates
// recent eval runs into bounded, evidence-linked param adjustments; a human
// reviews and either rejects (status: rejected) or applies (runner writes the
// new value into model-config.json and sets status: applied). Never auto-applied.
model RetrievalTuningProposal {
  id            String   @id @default(uuid())
  param         String
  oldValue      Float
  newValue      Float
  evidenceRunIds String[] @default([])
  rationale     String
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  appliedAt     DateTime?

  @@index([status, createdAt])
}
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Harness (pi) session journal: one row per pi SessionEntry, in append order.
// The worker rebuilds an AgentSession from these rows (SessionManager.inMemory)
// and appends new entries as the run produces them, so a restarted worker
// resumes the conversation's model context. `data` is the full entry JSON.
model SessionEntry {
  seq            BigInt       @id @default(autoincrement())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  entryId        String
  parentEntryId  String?
  type           String
  data           Json
  createdAt      DateTime     @default(now())

  @@unique([conversationId, entryId])
  @@index([conversationId, seq])
}

// One row per harness run (a user turn today; events and routines later).
// status: running | succeeded | failed | interrupted. Plain string, like
// ExtractedFact.status, because it will keep gaining states.
model AgentRun {
  id               String       @id @default(uuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trigger          String
  inputMessageId   String?
  inboxInputId     String? @unique
  replyMessageId   String?
  status           String       @default("running")
  model            String?
  steps            Int          @default(0)
  toolCalls        Int          @default(0)
  promptTokens     Int          @default(0)
  completionTokens Int          @default(0)
  costUsd          Float        @default(0)
  error            Json?
  startedAt        DateTime     @default(now())
  finishedAt       DateTime?
  journal          AgentStep[]
  approvals        ActionApproval[]
  // Background agents (trigger "agent"). Depth 1 runs are spawned by an
  // interaction run; depth 2 runs are in-turn delegations of a depth 1 run.
  // rootRunId is the depth 1 run, so a whole task can be costed and canceled.
  parentRunId      String?
  parent           AgentRun?    @relation("AgentRunTree", fields: [parentRunId], references: [id], onDelete: Cascade)
  children         AgentRun[]   @relation("AgentRunTree")
  rootRunId        String?
  depth            Int          @default(0)
  definitionId     String?
  definition       AgentDefinition? @relation(fields: [definitionId], references: [id])
  brief            Json?
  result           Json?
  budgetUsd        Float?
  messages         AgentMessage[]

  @@unique([inputMessageId])
  @@index([conversationId, startedAt])
  @@index([status])
  @@index([parentRunId])
  @@index([rootRunId])
  @@index([userId, trigger, status])
}

// Typed inputs are durable independently of BullMQ jobs. A single run can
// consume a burst and steering inputs; all point at its one covering reply.
model InboxInput {
  id             String @id @default(uuid())
  seq            BigInt @unique @default(autoincrement())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  kind           String
  source         String
  payload        Json
  dedupeKey      String
  messageId      String? @unique
  status         String @default("pending")
  runId          String?
  replyMessageId String?
  createdAt      DateTime @default(now())
  consumedAt     DateTime?

  @@unique([conversationId, dedupeKey])
  @@index([conversationId, status, seq])
}

// Delivery is at least once; clients acknowledge delivery IDs and suppress
// repeats. A receipt records transport acceptance, never claims human reading.
model Delivery {
  id             String @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  messageId      String @unique
  urgency        String
  reasonCode     String
  ambient        Boolean
  status         String @default("pending")
  availableAt    DateTime @default(now())
  leaseUntil     DateTime?
  leaseToken     String?
  attempts       Int @default(0)
  createdAt      DateTime @default(now())
  receipts       DeliveryReceipt[]

  @@index([status, availableAt])
}

model DeliveryReceipt {
  id         String @id @default(uuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  channel    String
  createdAt  DateTime @default(now())

  @@unique([deliveryId, channel])
}

model Routine {
  id             String @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  instruction    String @db.Text
  source         String // schedule | gmail | googlecalendar | github
  query          Json
  timing         Json // at | everyMs | cron (+ timezone); idle uses last user activity
  status         String @default("active")
  createdAt      DateTime @default(now())
  scratch        RoutineScratch?
  observations   RoutineObservation[]
}

model RoutineObservation {
  id        String @id @default(uuid())
  routineId String
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  key       String
  data      Json
  createdAt DateTime @default(now())

  @@unique([routineId, key])
}

model RoutineScratch {
  routineId      String @id
  routine        Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  fingerprint    String?
  checkedAt      DateTime?
  lastToldKey    String?
  notes          Json?
}

// Committed before executing a side effect. A started attempt found on recovery
// is uncertain and becomes interrupted; it is never automatically executed again.
model ActionAttempt {
  id             String @id @default(uuid())
  runId          String
  toolCallId     String
  toolName       String
  idempotencyKey String @unique
  arguments      Json @default("{}")
  status         String @default("started")
  result         Json?
  createdAt      DateTime @default(now())
  finishedAt     DateTime?

  @@unique([runId, toolCallId])
}

// The card and executor share these immutable arguments. Decisions change only
// status, never the tool or arguments. Ownership is inherited from the run.
model ActionApproval {
  id             String @id
  runId          String
  run            AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolCallId     String
  toolName       String
  provenance     String
  arguments      Json
  argumentHash   String
  risk           String
  reason         String
  status         String @default("pending")
  createdAt      DateTime @default(now())
  decidedAt      DateTime?
  expiresAt      DateTime

  @@unique([runId, toolCallId])
  @@index([status, expiresAt])
}

// Mimir-owned drafts keep unattended outbound mail inert. The send card expands
// the complete immutable message; execution uses that message, never model prose.
model EmailDraft {
  id             String @id
  userId         String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  to             String
  subject        String
  body           String @db.Text
  status         String @default("draft")
  createdAt      DateTime @default(now())

  @@index([userId, conversationId])
}

// Agent definitions are data: prompt, tools, model role, memory scope and
// limits. userId null marks a built-in available to everyone.
model AgentDefinition {
  id          String   @id
  userId      String?
  name        String
  description String
  prompt      String   @db.Text
  tools       Json     // tool names, or ["*"] for every read tool the user has
  modelRole   String   @default("subagent")
  memoryScope String   @default("conversation") // conversation | none
  canSpawn    Boolean  @default(false)
  maxSteps    Int
  maxUsd      Float
  timeoutSec  Int
  createdAt   DateTime @default(now())
  runs        AgentRun[]

  @@unique([userId, name])
}

// Follow-up instructions from the parent (message_agent), steered into the
// running agent at its next tool boundary.
model AgentMessage {
  id         String    @id @default(uuid())
  runId      String
  run        AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  text       String    @db.Text
  createdAt  DateTime  @default(now())
  consumedAt DateTime?

  @@index([runId, consumedAt])
}

model AgentStep {
  seq       BigInt   @id @default(autoincrement())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  kind      String
  data      Json
  createdAt DateTime @default(now())

  @@index([runId, seq])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([processedAt])
}

// User-supplied MCP servers: separate settings section, streamable-HTTP
// transport ONLY. stdio is intentionally off the table for user-added servers —
// it spawns an arbitrary binary on our infrastructure (arbitrary code exec).
// The tool schema is fetched + cached at registration; runtime failures map to
// generic ConnectionError/ToolError only (we don't control the server).
model McpServer {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  name         String
  url          String
  headers      Json?
  toolSchema   Json? // cached {name, description, inputSchema}[] from tools/list
  status       String    @default("pending") // pending | connected | error
  lastError    String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model IntegrationConnection {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  provider String
  // Opaque upstream connection id: the Nango connection_id OR the Composio
  // connected_account id. Provider-agnostic — either provider stores its id here.
  connectionId String @unique
  status       String
  // Provider-specific inbound-webhook state. Kept as one JSON blob on the
  // existing row (no parallel table) — the schema differs per provider:
  //   googlecalendar: { token, channelId, expiration } — the watch channel set
  //     on connect/renewal; the token gates /webhooks/calendar writes.
  //   github: { hooks: [{ repo, id, url }] } — the registered repo webhooks,
  //     removed on disconnect.
  webhookMeta Json?
  createdAt    DateTime @default(now())

  @@index([userId, provider])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  externalId  String
  rawPayload  Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, externalId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  keys      Json
  platform  String
  createdAt DateTime @default(now())
}

model UsageRecord {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  date       DateTime @db.Date
  tokensUsed Int      @default(0)

  @@unique([userId, date])
}
model AnalyticsEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  eventType  String
  properties Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

model ModelCallLog {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  useCase        String   // "chat_response" | "classification" | "agent_execution" | "summarization" | "embeddings"
  model          String   // model requested per model-config.json
  actualModel    String?  // model that actually served the request (response.model) — differs from `model` when the fallback chain triggered
  tokensUsed     Int      // total_tokens
  promptTokens   Int?
  completionTokens Int?
  cachedTokens   Int?     // token: usage.prompt_tokens_details.cached_tokens — prompt-cache hit signal
  finishReason   String?  // normalized finish_reason ("stop" | "length" | "content_filter" | "tool_calls" | "error")
  generationId   String?  // OpenRouter's response id — lets you query /api/v1/generation later for provider-level audit detail
  costCents      Int
  latencyMs      Int
  success        Boolean
  // 10.7 context snapshot: hashes + the structure (message ids, injected block
  // ids) of what was fed to the call. References only — text itself is not
  // duplicated here (it lives in the source tables).
  systemPromptHash String?
  injectedBlocks   Json? // ordered [{type, refIds}] — retrieved facts/events injected
  messageWindow    Json? // ordered message ids that formed the call's context
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([model, createdAt])
}
